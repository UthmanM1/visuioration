# Public base URL used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://visuioration.example

# --- Supabase -------------------------------------------------------------
# Leave both empty to run in demo mode (sample data, no sign-in).
# Set both to enable live mode: real accounts, workspaces and projects.
# Find them in Supabase: Project Settings → API (or "API Keys").
NEXT_PUBLIC_SUPABASE_URL=
# Either the anon key or the newer publishable key (sb_publishable_...). Both are safe to expose;
# Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Never add the service role / secret key to this app. It is not needed and must not reach the browser.

# --- Demo mode ------------------------------------------------------------
# Production builds WITHOUT Supabase close the workspace (HTTP 503) instead of silently running the demo.
# Set to "true" only for a deliberate sample-data demo deployment. Ignored when Supabase is configured.
# NEXT_PUBLIC_DEMO_MODE=true

# --- AI (optional, live mode only) ---------------------------------------
# Server-only. Enables AI Insights; without it the page explains how to connect AI.
ANTHROPIC_API_KEY=
# Model id (default: claude-sonnet-5). See https://platform.claude.com/docs/en/about-claude/models/overview
# AI_MODEL=claude-sonnet-5
# Questions each user can ask per hour (default: 30).
# AI_MAX_QUESTIONS_PER_HOUR=30
# Only for proxies or testing; defaults to https://api.anthropic.com
# ANTHROPIC_BASE_URL=

# --- Scheduled storage clean-up (live mode) ---------------------------------
# Server-only. Used ONLY by app/api/cron/storage-cleanup. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# At least 16 random characters. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
# Optional grace period before an orphaned file may be deleted (seconds, default 86400, minimum 3600).
# STORAGE_CLEANUP_MIN_AGE_SECONDS=86400

# --- Rate limiting ------------------------------------------------------------
# Recommended. Salt for hashing client IPs and share tokens in rate-limit counters.
RATE_LIMIT_SALT=
